        {
          "name": "Register Org",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201))",
                  "const json = pm.response.json()",
                  "pm.collectionVariables.set(\"token\", json.data.token)",
                  "pm.collectionVariables.set(\"orgId\", json.data.org._id)"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orgName\": \"Acme Corp\",\n  \"timezone\": \"Africa/Cairo\",\n  \"adminName\": \"Ahmed Admin\",\n  \"email\": \"admin@acme.com\",\n  \"password\": \"Admin1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register-org",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register-org"]
            },
            "description": "Registers a new organization and default HR admin user."
